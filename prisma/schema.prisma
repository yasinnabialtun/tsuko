generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String              @id @default(cuid())
  name           String
  description    String
  price          Decimal             @db.Decimal(10, 2)
  images         String[]
  stock          Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attributes     Json?
  categoryId     String
  isActive       Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  modelUrl       String?
  seoDescription String?
  seoKeywords    String[]
  seoTitle       String?
  slug           String              @unique
  OrderItem      OrderItem[]
  category       Category            @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  reviews        Review[]
  lookPins       ShopTheLookPin[]
  notifications  StockNotification[]
  Wishlist       Wishlist[]

  @@index([slug])
  @@index([categoryId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  sku        String      @unique
  title      String
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(0)
  weight     Float?
  attributes Json
  images     String[]
  isActive   Boolean     @default(true)
  OrderItem  OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model StockNotification {
  id         String   @id @default(cuid())
  email      String
  productId  String
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([email, productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  rating     Int
  comment    String?
  userName   String
  userId     String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
}

model Order {
  id              String        @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  city            String        @default("")
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  couponCode      String?
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  orderNumber     String        @unique
  paymentStatus   PaymentStatus @default(UNPAID)
  shippingAddress String        @default("")
  trackingNumber  String?
  userId          String?
  affiliateId     String?
  carrier         String?
  affiliate       Affiliate?    @relation(fields: [affiliateId], references: [id])
  items           OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal         @db.Decimal(10, 2)
  variantId String?
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model UserAddress {
  id            String   @id @default(cuid())
  userId        String
  title         String
  recipientName String
  phone         String
  address       String
  city          String
  district      String
  zipCode       String
  country       String   @default("Türkiye")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website")
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String
  content    String
  coverImage String
  category   String
  author     String   @default("Tsuko Design")
  published  Boolean  @default(true)
  date       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  seoDesc    String?
  seoTitle   String?

  @@index([slug])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String
  discountValue Decimal   @db.Decimal(10, 2)
  minAmount     Decimal?  @db.Decimal(10, 2)
  startDate     DateTime?
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Settings {
  id                      String   @id @default("singleton")
  siteName                String   @default("Tsuko Design")
  siteDescription         String   @default("Mimari Estetik, Evinize Taşındı")
  siteUrl                 String   @default("https://tsukodesign.com")
  seoKeywords             String[] @default([])
  email                   String   @default("info@tsukodesign.com")
  phone                   String   @default("")
  whatsapp                String   @default("")
  address                 String   @default("")
  instagram               String   @default("tsukodesign")
  pinterest               String   @default("")
  shopierUrl              String   @default("")
  freeShippingThreshold   Decimal  @default(500) @db.Decimal(10, 2)
  orderNotifications      Boolean  @default(true)
  stockAlerts             Boolean  @default(true)
  newsletterNotifications Boolean  @default(true)
  maintenanceMode         Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  announcementActive      Boolean  @default(true)
  announcementBar         String   @default("TÜM TÜRKİYE'YE ÜCRETSİZ KARGO")
  heroButtonLink          String   @default("/collection")
  heroButtonText          String   @default("KOLEKSİYONU KEŞFET")
  heroImage               String   @default("/images/hero.png")
  heroSubtitle            String   @default("Evinizin ruhunu yansıtan, sürdürülebilir ve estetik parçalar.")
  heroTitle               String   @default("ZAMANIN ÖTESİNDE TASARIMLAR")
  philosophyContent       String   @default("Tsuko, Japonca'da 'yaratmak' anlamına gelir. Biz sadece obje değil, yaşam alanlarınıza karakter katan hikayeler tasarlıyoruz. Her bir parça, mimari disiplin ve sanatın buluşma noktasıdır.")
  philosophyTitle         String   @default("MİMARİ BAKIŞ")
  exitIntentDesc          String   @default("Sepetindeki ürünleri kaçırma! Şimdi tamamla, ücretsiz kargo fırsatını yakala.")
  exitIntentTitle         String   @default("GİTMEDEN ÖNCE...")
  newsletterPopupDesc     String   @default("Bültene abone ol, indirim kodunu hemen kap. Yeni koleksiyonlardan ilk senin haberin olsun.")
  newsletterPopupImage    String   @default("/images/popup.jpg")
  newsletterPopupTitle    String   @default("İLK SİPARİŞİNE ÖZEL %10 İNDİRİM")
}

model ShopTheLook {
  id          String           @id @default(cuid())
  title       String
  description String?
  image       String
  isActive    Boolean          @default(true)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  pins        ShopTheLookPin[]
}

model ShopTheLookPin {
  id        String      @id @default(cuid())
  lookId    String
  productId String
  x         Float
  y         Float
  createdAt DateTime    @default(now())
  look      ShopTheLook @relation(fields: [lookId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorSession {
  id        String   @id @default(cuid())
  country   String?  @default("Turkey")
  city      String?
  lat       Float?
  lng       Float?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([lastSeen])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model LiveActivity {
  id          String   @id @default(cuid())
  type        String
  city        String?
  productName String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Affiliate {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  commissionRate Decimal  @default(10) @db.Decimal(5, 2)
  contact        String?
  iban           String?
  totalSales     Decimal  @default(0) @db.Decimal(10, 2)
  totalEarnings  Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
